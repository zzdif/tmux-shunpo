ui_edit_marks() {
    check_gum

    local -A marks
    while true; do
        # Read all marks once per display refresh (1 file read vs 9 parse_marks calls)
        marks=()
        local mark_line
        while IFS= read -r mark_line; do
            [[ -z "${mark_line}" || "${mark_line}" =~ ^[[:space:]]*# ]] && continue
            if [[ "${mark_line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
                local m_slot="${BASH_REMATCH[1]}"
                local m_val="${BASH_REMATCH[2]}"
                m_val="${m_val#"${m_val%%[![:space:]]*}"}"
                m_val="${m_val%"${m_val##*[![:space:]]}"}"
                [[ -n "${m_val}" && "${m_slot}" -ge 1 && "${m_slot}" -le 9 ]] && marks["${m_slot}"]="${m_val}"
            fi
        done < "${MARKS_FILE}" 2>/dev/null || true

        clear
        gum style --border rounded --padding "0 1" \
            --border-foreground 212 --bold "${CFG_TOOL_WINDOW_PREFIX} Marks"

        local slot
        for slot in {1..9}; do
            if [[ -n "${marks[${slot}]:-}" ]]; then
                printf '  %d  %s\n' "${slot}" "${marks[${slot}]}"
            else
                printf '  %d  %s\n' "${slot}" "(empty)"
            fi
        done
        printf '\n'

        local action
        action=$(gum choose "Set mark" "Clear mark" "Done") || break

        case "${action}" in
            "Set mark")
                # Build rich slot list using cached marks (no extra file reads)
                local -a choices=()
                local default_choice=""
                local s
                for s in {1..9}; do
                    local val="${marks[${s}]:-}"
                    if [[ -n "${val}" ]]; then
                        choices+=("${s}: ${val}")
                    else
                        choices+=("${s}: (empty)")
                    fi
                    if [[ -z "${val}" && -z "${default_choice}" ]]; then
                        default_choice="${s}: (empty)"
                    fi
                done
                local slot_choice
                slot_choice=$(printf '%s\n' "${choices[@]}" | gum choose --header "Select slot" --selected "${default_choice}") || continue
                slot_choice="${slot_choice%%:*}"

                local method
                method=$(gum choose --header "Source" \
                    "Pick from sesh sessions" \
                    "Enter manually") || continue

                local new_value=""
                case "${method}" in
                    "Pick from sesh sessions")
                        new_value=$(sesh list -t -c -z 2>/dev/null | gum filter \
                            --header "Select session" \
                            --placeholder "Filter...") || continue
                        ;;
                    "Enter manually")
                        local current="${marks[${slot_choice}]:-}"
                        new_value=$(gum input \
                            --header "Session name or path for slot ${slot_choice}" \
                            --placeholder "session-name or ~/path" \
                            --value "${current}") || continue
                        ;;
                esac

                # Trim leading/trailing whitespace from sesh/gum output
                new_value="${new_value#"${new_value%%[![:space:]]*}"}"
                new_value="${new_value%"${new_value##*[![:space:]]}"}"

                [[ -z "${new_value}" ]] && continue
                mark_set "${slot_choice}" "${new_value}"
                ;;
            "Clear mark")
                local -a filled=()
                for slot in {1..9}; do
                    if [[ -n "${marks[${slot}]:-}" ]]; then
                        filled+=("${slot}: ${marks[${slot}]}")
                    fi
                done
                if [[ ${#filled[@]} -eq 0 ]]; then
                    gum style --foreground 208 "No marks to clear"
                    sleep 1
                    continue
                fi
                local to_clear
                to_clear=$(printf '%s\n' "${filled[@]}" | gum choose \
                    --header "Select mark to clear") || continue
                local clear_slot="${to_clear%%:*}"
                mark_remove "${clear_slot}"
                ;;
            "Done")
                break
                ;;
        esac
    done
}

ui_edit_tools() {
    check_gum

    local session_name
    session_name=$(tmux display-message -p '#S' 2>/dev/null) || {
        notify "Not in a tmux session" "error"
        return 1
    }

    validate_session_name "${session_name}" || error_exit "Invalid session name: ${session_name}"

    # Load templates once (cached, no yq fork after first load)
    _sesh_load_templates
    local -A templates
    for name in "${!_SESH_TEMPLATES[@]}"; do
        templates["${name}"]="${_SESH_TEMPLATES[${name}]}"
    done

    tool_auto_populate "${session_name}"

    # Read tools once per loop iteration (1 file read vs 9 get_tool calls)
    local -A tool_cmds
    while true; do
        # Refresh tool data from file (1 read vs 9 get_tool calls)
        tool_cmds=()
        local tools_file="${DATA_DIR}/tools/${session_name}"
        if [[ -f "${tools_file}" ]]; then
            local t_line t_slot t_cmd
            while IFS= read -r t_line; do
                [[ -z "${t_line}" || "${t_line}" =~ ^[[:space:]]*# ]] && continue
                if [[ "${t_line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
                    t_slot="${BASH_REMATCH[1]}"
                    t_cmd="${BASH_REMATCH[2]}"
                    t_cmd="${t_cmd#"${t_cmd%%[![:space:]]*}"}"
                    t_cmd="${t_cmd%"${t_cmd##*[![:space:]]}"}"
                    if [[ -n "${t_cmd}" && "${t_slot}" -ge 1 && "${t_slot}" -le 9 ]]; then
                        tool_cmds["${t_slot}"]="${t_cmd}"
                        # Resolve @template from cache (no yq fork)
                        if [[ "${t_cmd}" =~ ^@([a-zA-Z0-9_-]+)$ ]]; then
                            local tmpl="${BASH_REMATCH[1]}"
                            if [[ -n "${_SESH_TEMPLATES[${tmpl}]:-}" ]]; then
                                : # resolved via templates cache at display time
                            elif [[ "${tmpl}" == "shell" ]]; then
                                : # shell resolved at display time
                            fi
                        else
                            : # inline command, no resolution
                        fi
                    fi
                fi
            done < "${tools_file}"
        fi

        clear
        gum style --border rounded --padding "0 1" \
            --border-foreground 212 --bold "${CFG_TOOL_WINDOW_PREFIX} Tools — ${session_name}"

        local slot
        for slot in {1..9}; do
            if [[ -n "${tool_cmds[${slot}]:-}" ]]; then
                local cmd="${tool_cmds[${slot}]}"
                if [[ "${cmd}" =~ ^@([a-zA-Z0-9_-]+)$ ]]; then
                    local expanded="${templates[${BASH_REMATCH[1]}]:-?}"
                    printf '  @%d  %s (→ %s)\n' "${slot}" "${cmd}" "${expanded}"
                else
                    printf '  @%d  %s\n' "${slot}" "${cmd}"
                fi
            else
                printf '  @%d  %s\n' "${slot}" "(empty)"
            fi
        done
        printf '\n'

        local action
        action=$(gum choose "Set tool" "Clear tool" "Done") || break

        case "${action}" in
            "Set tool")
                # Build rich slot list using cached data (no get_tool calls)
                local -a choices=()
                local default_choice=""
                local s
                for s in {1..9}; do
                    if [[ -n "${tool_cmds[${s}]:-}" ]]; then
                        local cmd="${tool_cmds[${s}]}"
                        if [[ "${cmd}" =~ ^@([a-zA-Z0-9_-]+)$ ]]; then
                            local expanded="${templates[${BASH_REMATCH[1]}]:-?}"
                            choices+=("${s}: ${cmd} (→ ${expanded})")
                        else
                            choices+=("${s}: ${cmd}")
                        fi
                    else
                        choices+=("${s}: (empty)")
                    fi
                    if [[ -z "${tool_cmds[${s}]:-}" && -z "${default_choice}" ]]; then
                        default_choice="${s}: (empty)"
                    fi
                done
                local slot_choice
                slot_choice=$(printf '%s\n' "${choices[@]}" | gum choose --header "Select slot" --selected "${default_choice}") || continue
                slot_choice="${slot_choice%%:*}"

                local method
                method=$(gum choose --header "Source" \
                    "Pick from sesh window templates" \
                    "Enter command manually" \
                    "Shell (default shell)") || continue

                local new_cmd=""
                case "${method}" in
                    "Pick from sesh window templates")
                        if [[ ${#templates[@]} -eq 0 ]]; then
                            gum style --foreground 208 \
                                "No [[window]] entries in sesh.toml"
                            sleep 1
                            continue
                        fi
                        local template_names
                        template_names=$(printf '%s\n' "${!templates[@]}")
                        local picked
                        picked=$(printf '%s' "${template_names}" | gum filter \
                            --header "Select template") || continue
                        new_cmd="@${picked}"
                        ;;
                    "Enter command manually")
                        local current_cmd="${tool_cmds[${slot_choice}]:-}"
                        new_cmd=$(gum input \
                            --header "Command for slot @${slot_choice}" \
                            --placeholder "e.g. nvim . or cargo watch -x run" \
                            --value "${current_cmd}") || continue
                        if [[ ! "${new_cmd}" =~ ^@ ]]; then
                            if ! validate_command "${new_cmd}" 2>/dev/null; then
                                gum style --foreground 196 \
                                    "Invalid command: contains unsafe characters"
                                sleep 1
                                continue
                            fi
                        fi
                        ;;
                    "Shell (default shell)")
                        new_cmd="@shell"
                        ;;
                esac

                [[ -z "${new_cmd}" ]] && continue
                tool_set "${session_name}" "${slot_choice}" "${new_cmd}"
                ;;
            "Clear tool")
                local -a filled=()
                for slot in {1..9}; do
                    if [[ -n "${tool_cmds[${slot}]:-}" ]]; then
                        filled+=("@${slot}: ${tool_cmds[${slot}]}")
                    fi
                done
                if [[ ${#filled[@]} -eq 0 ]]; then
                    gum style --foreground 208 "No tools to clear"
                    sleep 1
                    continue
                fi
                local to_clear
                to_clear=$(printf '%s\n' "${filled[@]}" | gum choose \
                    --header "Select tool to clear") || continue
                local clear_slot="${to_clear#@}"
                clear_slot="${clear_slot%%:*}"
                tool_remove "${session_name}" "${clear_slot}"
                ;;
            "Done")
                break
                ;;
        esac
    done
}

# =============================================================================
# RESET
# =============================================================================

data_reset() {
    local scope="${1:-session}"

    case "${scope}" in
        session)
            local session_name
            session_name=$(tmux display-message -p '#S' 2>/dev/null) || {
                notify "Not in a tmux session" "error"
                return 1
            }
            local tools_file="${DATA_DIR}/tools/${session_name}"
            if [[ -f "${tools_file}" ]]; then
                if [[ -t 0 ]]; then
                    echo "Delete tools for session '${session_name}'? (y/N): "
                    local REPLY
                    read -r REPLY
                    if [[ ${REPLY} =~ ^[Yy]$ ]]; then
                        rm -f "${tools_file}"
                        notify "Tools for session '${session_name}' reset"
                    else
                        notify "Reset cancelled"
                    fi
                else
                    rm -f "${tools_file}"
                    notify "Tools for session '${session_name}' reset"
                fi
            else
                notify "No tools file found for session '${session_name}'"
            fi
            ;;
        all)
            if [[ -t 0 ]]; then
                echo "Delete ALL tmux-shunpo data? (y/N): "
                local REPLY
                read -r REPLY
                if [[ ${REPLY} =~ ^[Yy]$ ]]; then
                    rm -f "${MARKS_FILE}"
                    rm -rf "${DATA_DIR}/tools"
                    mkdir -p "${DATA_DIR}/tools"
                    notify "All tmux-shunpo data reset"
                else
                    notify "Reset cancelled"
                fi
            else
                rm -f "${MARKS_FILE}"
                rm -rf "${DATA_DIR}/tools"
                mkdir -p "${DATA_DIR}/tools"
                notify "All tmux-shunpo data reset"
            fi
            ;;
        *)
            error_exit "Invalid reset scope '${scope}'. Use 'session' or 'all'"
            ;;
    esac
}

# =============================================================================
# USAGE & CLI
# =============================================================================

show_usage() {
    cat <<'EOF'
Usage: tmux-shunpo [OPTION]

Session Navigation:
  --search               Fuzzy search sessions via sesh + fzf (tmux popup when from keybinding)
  --goto N               Jump to mark slot N (1-9) via sesh connect
  --goto @N              Navigate to tool window slot N (1-9)

Mark Management:
  --add                  Mark current session (inside tmux) or current directory (outside tmux)
  --remove N             Remove mark slot N
  --remove all           Remove all marks
  --marks                Interactive mark editor (gum TUI, tmux popup when from keybinding)

Tool Management:
  --tools                Interactive tool editor for current session (gum TUI, tmux popup)

Maintenance:
  --reset [session|all]  Reset tools for current session, or all data

Info:
  -h, --help             Show usage
  -v, --version          Show version

Configuration:
  ~/.config/tmux-shunpo/config.toml    UI/behavior settings, default_tools
  ~/.config/sesh/sesh.toml             Session + window templates
  ~/.local/share/tmux-shunpo/marks     Mark storage
  ~/.local/share/tmux-shunpo/tools/    Per-session tool storage

Auto-populate tool slots for new sessions (in precedence order):
  1. config.toml  default_tools = ["@name", "raw-cmd", ...]
  2. sesh.toml    [[session]].windows / [[wildcard]].windows / [default_session].windows
EOF
}

main() {
    # Warn about deprecated config.conf
    if [[ -f "${CONFIG_DIR}/config.conf" && ! -f "${CONFIG_FILE}" ]]; then
        notify "config.conf is deprecated. Create config.toml (see --help)" "error"
    fi

    # Context-aware dependency checks — only check what each command needs
    case "${1:-}" in
        --marks|--tools)
            check_dependencies
            check_gum
            ;;
        --search)
            check_dependencies
            ;;
        --goto)
            # --goto N needs tmux+sesh; --goto @N needs tmux only
            # Defer granular check to after arg parsing; check common minimum
            command_exists tmux || error_exit "missing required tool: tmux>=3.2"
            ;;
        --add)
            command_exists tmux || error_exit "missing required tool: tmux>=3.2"
            ;;
        --remove|--reset)
            command_exists tmux || error_exit "missing required tool: tmux>=3.2"
            ;;
        "")
            : ;; # no deps needed for --help/--version
        -h|--help|-v|--version)
            : ;;
        *)
            check_dependencies
            ;;
    esac

    cfg_load || exit 1

    case "${1:-}" in
        -h|--help)
            show_usage
            exit 0
            ;;
        -v|--version)
            echo "tmux-shunpo v${VERSION}"
            exit 0
            ;;
        "")
            show_usage
            exit 0
            ;;
        --search)
            search_and_connect
            ;;
        --goto)
            if [[ -z "${2:-}" ]]; then
                error_exit "--goto requires a target (mark slot or @tool)"
            fi
            if [[ "$2" =~ ^@([1-9])$ ]]; then
                navigate_to_tool "${BASH_REMATCH[1]}"
            else
                command_exists sesh || error_exit "missing required tool: sesh"
                mark_jump_to "$2"
            fi
            ;;
        --add)
            mark_add
            ;;
        --remove)
            if [[ -z "${2:-}" ]]; then
                error_exit "--remove requires a target (mark slot number or 'all')"
            fi
            mark_remove "$2"
            ;;
        --marks)
            if [[ ! -t 0 && -n "${TMUX:-}" ]]; then
                local script_path
                script_path=$(_get_script_path)
                tmux display-popup -E -w "${CFG_POPUP_WIDTH}" -h "${CFG_POPUP_HEIGHT}" \
                    "${script_path} --marks"
                exit 0
            fi
            ui_edit_marks
            ;;
        --tools)
            if [[ ! -t 0 && -n "${TMUX:-}" ]]; then
                local script_path
                script_path=$(_get_script_path)
                tmux display-popup -E -w "${CFG_POPUP_WIDTH}" -h "${CFG_POPUP_HEIGHT}" \
                    "${script_path} --tools"
                exit 0
            fi
            ui_edit_tools
            ;;
        --reset)
            data_reset "${2:-session}"
            ;;
        *)
            error_exit "Unknown option '$1'. Use --help for usage information."
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]:-}" == "${0}" ]]; then
    main "$@"
fi
