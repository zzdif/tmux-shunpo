#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2310,SC2249,SC2064
# SC2310: Functions called in conditions for intentional error handling.
# SC2249: Default case patterns omitted where all cases are explicitly handled.
# SC2064: Trap variables expand at definition time (correct for temp files).

# =============================================================================
# tmux-shunpo — Harpoon2-style tmux navigation (v0.1.0)
# =============================================================================
# Fast session marks (1-9) and per-session tools (@1-@9).
# Delegates session management to sesh. Uses gum for interactive editors.
#
# DEPENDENCIES: bash>=4.0, tmux>=3.2, sesh, yq, gum, fzf|sk
# =============================================================================

VERSION="0.1.0"

set -euo pipefail

# Ensure tmux/sesh/yq/gum binaries are in PATH when called from tmux run-shell/popup
# where PATH may differ from interactive shell (common with nix/homebrew).
_ensure_in_path() {
    local bin_path
    bin_path=$(command -v "$1" 2>/dev/null) || return 0
    local bin_dir="${bin_path%/*}"  # bash string op instead of dirname fork
    case ":${PATH}:" in
        *":${bin_dir}:"*) ;;
        *) export PATH="${bin_dir}:${PATH}" ;;
    esac
}
_ensure_in_path tmux
_ensure_in_path sesh
_ensure_in_path yq
_ensure_in_path gum
unset -f _ensure_in_path

if [[ "${DEBUG:-}" == "1" ]]; then
    export PS4='+[${BASH_SOURCE[0]##*/}:${LINENO}${FUNCNAME[0]:+:${FUNCNAME[0]}()}] '
    set -x
fi

# =============================================================================
# PATHS
# =============================================================================

CONFIG_DIR="${CONFIG_DIR:-${HOME}/.config/tmux-shunpo}"
CONFIG_FILE="${CONFIG_FILE:-${CONFIG_DIR}/config.toml}"
DATA_DIR="${DATA_DIR:-${HOME}/.local/share/tmux-shunpo}"
MARKS_FILE="${MARKS_FILE:-${DATA_DIR}/marks}"
SESH_CONFIG="${SESH_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/sesh/sesh.toml}"

# Lazy script path resolution — only computed when --marks/--tools need popup re-invoke
SCRIPT_PATH=""
_get_script_path() {
    if [[ -z "${SCRIPT_PATH}" ]]; then
        local local_dir="${BASH_SOURCE[0]%/*}"
        local local_base="${BASH_SOURCE[0]##*/}"
        SCRIPT_PATH="$(cd "${local_dir}" && pwd)/${local_base}"
    fi
    printf '%s' "${SCRIPT_PATH}"
}

[[ -d "${CONFIG_DIR}" ]] || mkdir -p "${CONFIG_DIR}" || { echo "Error: cannot create config directory" >&2; exit 1; }
[[ -d "${DATA_DIR}" ]] || mkdir -p "${DATA_DIR}" || { echo "Error: cannot create data directory" >&2; exit 1; }

# Cache current UID once (avoids repeated id -u forks in cfg_check_file_safety)
_CURRENT_UID=$(id -u)

# Sesh config caches (loaded once per invocation, avoids repeated yq forks)
declare -gA _SESH_TEMPLATES=()
declare -gA _SESH_SESSION_WINDOWS=()
declare -gA _SESH_SESSION_PATHS=()
declare -ga _SESH_WILDCARD_PATTERNS=()
declare -gA _SESH_WILDCARD_WINDOWS=()
_SESH_DEFAULT_WINDOWS=""
_SESH_TEMPLATES_LOADED=false
_SESH_SESSIONS_LOADED=false

# =============================================================================
# CONFIGURATION (populated by cfg_load)
# =============================================================================

CFG_TOOL_WINDOW_BASE=88
CFG_SHELL_INIT_DELAY=0.1
CFG_WINDOW_NAME_MAX_LENGTH=20
CFG_POPUP_WIDTH="80%"
CFG_POPUP_HEIGHT="70%"
CFG_FINDER_HEIGHT_PERCENT=50
CFG_FINDER_PREVIEW_PERCENT=50
CFG_TOOL_WINDOW_PREFIX="⚡"

# =============================================================================
# CORE UTILITIES
# =============================================================================

notify() {
    local message="$1"
    local is_error="${2:-}"
    if [[ -t 0 ]]; then
        if [[ "${is_error}" == "error" ]]; then
            echo "${message}" >&2
        else
            echo "${message}"
        fi
    else
        tmux display-message "${message}"
    fi
}

error_exit() {
    local message="$1"
    local exit_code="${2:-1}"
    notify "${message}" "error"
    # In keybinding context (no TTY, inside tmux), notify already sent
    # tmux display-message. Exit 0 to prevent tmux run-shell from
    # showing an ugly "returned 1" full-screen overlay.
    if [[ ! -t 0 && -n "${TMUX:-}" ]]; then
        exit 0
    fi
    exit "${exit_code}"
}

validate_range() {
    local value="$1"
    local min="$2"
    local max="$3"
    local error_msg="$4"
    if [[ ! "${value}" =~ ^[0-9]+$ ]] || [[ "${value}" -lt "${min}" ]] || [[ "${value}" -gt "${max}" ]]; then
        error_exit "${error_msg}"
    fi
}

command_exists() {
    command -v "$1" &> /dev/null
}

atomic_write() {
    local file_path="$1"
    local content="$2"
    local temp_file="${file_path}.tmp.$$"
    mkdir -p "${file_path%/*}" || error_exit "Cannot create directory for: ${file_path}"
    printf '%s\n' "${content}" > "${temp_file}" || error_exit "Cannot write to temp file: ${temp_file}"
    mv -- "${temp_file}" "${file_path}" || { rm -f "${temp_file}"; error_exit "Cannot move temp file to: ${file_path}"; }
}

# =============================================================================
# DEPENDENCY CHECKS
# =============================================================================

check_dependencies() {
    local missing=()
    command_exists bash || missing+=("bash>=4.0")
    command_exists tmux || missing+=("tmux>=3.2")
    command_exists sesh || missing+=("sesh")
    command_exists yq || missing+=("yq (Go version)")

    if ! command_exists fzf && ! command_exists sk; then
        missing+=("fzf or sk")
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        error_exit "missing required tools: ${missing[*]}"
    fi
}

check_gum() {
    if ! command_exists gum; then
        error_exit "gum is required for this command. Install charmbracelet/gum"
    fi
}

# =============================================================================
# CONFIG LOADING
# =============================================================================

cfg_check_file_safety() {
    local filepath="$1"
    [[ ! -f "${filepath}" ]] && return 0

    # Single stat call gets both owner uid and permissions (1 fork instead of 4)
    local stat_info file_owner file_perms
    if stat_info=$(stat -f '%u %Lp' "${filepath}" 2>/dev/null); then
        # macOS
        read -r file_owner file_perms <<< "${stat_info}"
    elif stat_info=$(stat -c '%u %a' "${filepath}" 2>/dev/null); then
        # Linux
        read -r file_owner file_perms <<< "${stat_info}"
    else
        echo "error: cannot stat config file: ${filepath}" >&2
        return 1
    fi

    if [[ "${file_owner}" != "${_CURRENT_UID}" ]]; then
        echo "error: config file owned by another user: ${filepath}" >&2
        return 1
    fi

    local world_bit="${file_perms:2:1}"
    if [[ "${world_bit}" =~ [2367] ]]; then
        echo "error: config file is world-writable: ${filepath} (mode ${file_perms})" >&2
        return 1
    fi

    return 0
}

cfg_load() {
    CFG_TOOL_WINDOW_BASE=88
    CFG_SHELL_INIT_DELAY=0.2
    CFG_WINDOW_NAME_MAX_LENGTH=20
    CFG_POPUP_WIDTH="80%"
    CFG_POPUP_HEIGHT="70%"
    CFG_FINDER_HEIGHT_PERCENT=50
    CFG_FINDER_PREVIEW_PERCENT=50
    CFG_TOOL_WINDOW_PREFIX="⚡"
    CFG_DEFAULT_TOOLS_JSON=""

    if ! cfg_check_file_safety "${CONFIG_FILE}"; then
        return 1
    fi
    if ! cfg_check_file_safety "${SESH_CONFIG}"; then
        return 1
    fi

    [[ ! -f "${CONFIG_FILE}" ]] && return 0

    # Single yq call extracts all config as KEY=VALUE lines (1 fork instead of 9)
    local cfg_output
    cfg_output=$(yq -p toml '
        "tool_window_base=" + (.tool_window_base // 88 | tostring),
        "shell_init_delay=" + (.shell_init_delay // 0.2 | tostring),
        "window_name_max_length=" + (.window_name_max_length // 20 | tostring),
        "popup_width=" + (.ui.popup_width // "80%"),
        "popup_height=" + (.ui.popup_height // "70%"),
        "finder_height_percent=" + (.finder.height_percent // 50 | tostring),
        "finder_preview_percent=" + (.finder.preview_percent // 50 | tostring),
        "tool_window_prefix=" + (.tool_window_prefix // "⚡"),
        "default_tools_json=" + (.default_tools // [] | tojson)
    ' "${CONFIG_FILE}" 2>/dev/null) || {
        notify "Failed to parse config: ${CONFIG_FILE}" "error"
        return 1
    }

    # Parse KEY=VALUE lines with whitelisted keys only (SEC-06: no eval/source)
    local key val
    while IFS='=' read -r key val; do
        [[ -z "${key}" ]] && continue
        case "${key}" in
            tool_window_base)        CFG_TOOL_WINDOW_BASE="${val}" ;;
            shell_init_delay)        CFG_SHELL_INIT_DELAY="${val}" ;;
            window_name_max_length)  CFG_WINDOW_NAME_MAX_LENGTH="${val}" ;;
            popup_width)             CFG_POPUP_WIDTH="${val}" ;;
            popup_height)            CFG_POPUP_HEIGHT="${val}" ;;
            finder_height_percent)   CFG_FINDER_HEIGHT_PERCENT="${val}" ;;
            finder_preview_percent)  CFG_FINDER_PREVIEW_PERCENT="${val}" ;;
            tool_window_prefix)      CFG_TOOL_WINDOW_PREFIX="${val}" ;;
            default_tools_json)
                [[ -n "${val}" && "${val}" != "[]" && "${val}" != "null" ]] && CFG_DEFAULT_TOOLS_JSON="${val}"
                ;;
        esac
    done <<< "${cfg_output}"

    # Validate numeric configs — malformed values fall back to defaults
    [[ "${CFG_TOOL_WINDOW_BASE}" =~ ^[0-9]+$ ]] || CFG_TOOL_WINDOW_BASE=88
    [[ "${CFG_SHELL_INIT_DELAY}" =~ ^[0-9]+\.?[0-9]*$ ]] || CFG_SHELL_INIT_DELAY=0.1
    [[ "${CFG_WINDOW_NAME_MAX_LENGTH}" =~ ^[0-9]+$ ]] || CFG_WINDOW_NAME_MAX_LENGTH=20
    [[ "${CFG_FINDER_HEIGHT_PERCENT}" =~ ^[0-9]+$ ]] || CFG_FINDER_HEIGHT_PERCENT=50
    [[ "${CFG_FINDER_PREVIEW_PERCENT}" =~ ^[0-9]+$ ]] || CFG_FINDER_PREVIEW_PERCENT=50
}

# =============================================================================
# SESH CONFIG CACHE (avoids repeated yq forks)
# =============================================================================

# Load sesh window templates into _SESH_TEMPLATES (1 yq fork, cached)
_sesh_load_templates() {
    if [[ "${_SESH_TEMPLATES_LOADED}" == true ]]; then
        return 0
    fi
    _SESH_TEMPLATES=()
    if [[ ! -f "${SESH_CONFIG}" ]]; then
        _SESH_TEMPLATES_LOADED=true
        return 0
    fi
    local out name command
    out=$(yq -p toml '.window[] | [.name, (.startup_script // "")] | @tsv' "${SESH_CONFIG}" 2>/dev/null) || true
    while IFS=$'\t' read -r name command; do
        [[ -n "${name}" ]] && _SESH_TEMPLATES["${name}"]="${command}"
    done <<< "${out}"
    _SESH_TEMPLATES_LOADED=true
}

# Load sesh session/wildcard/default data into caches (2 yq forks, cached)
_sesh_load_sessions() {
    if [[ "${_SESH_SESSIONS_LOADED}" == true ]]; then
        return 0
    fi
    _SESH_SESSION_WINDOWS=()
    _SESH_SESSION_PATHS=()
    _SESH_WILDCARD_PATTERNS=()
    _SESH_WILDCARD_WINDOWS=()
    _SESH_DEFAULT_WINDOWS=""

    if [[ ! -f "${SESH_CONFIG}" ]]; then
        _SESH_SESSIONS_LOADED=true
        return 0
    fi

    local sessions_tsv name path windows
    sessions_tsv=$(yq -p toml '.session[] | [.name, (.path // ""), ((.windows // []) | join(","))] | @tsv' "${SESH_CONFIG}" 2>/dev/null) || true
    while IFS=$'\t' read -r name path windows; do
        [[ -n "${name}" ]] || continue
        _SESH_SESSION_PATHS["${name}"]="${path}"
        _SESH_SESSION_WINDOWS["${name}"]="${windows}"
    done <<< "${sessions_tsv}"

    local wildcards_tsv pattern
    wildcards_tsv=$(yq -p toml '.wildcard[] | [.pattern, ((.windows // []) | join(","))] | @tsv' "${SESH_CONFIG}" 2>/dev/null) || true
    while IFS=$'\t' read -r pattern windows; do
        [[ -n "${pattern}" ]] || continue
        _SESH_WILDCARD_PATTERNS+=("${pattern}")
        _SESH_WILDCARD_WINDOWS["${pattern}"]="${windows}"
    done <<< "${wildcards_tsv}"

    _SESH_DEFAULT_WINDOWS=$(yq -p toml '(.default_session.windows // []) | join(",")' "${SESH_CONFIG}" 2>/dev/null) || true

    _SESH_SESSIONS_LOADED=true
}

# =============================================================================
# SECURITY & VALIDATION
# =============================================================================

validate_command() {
    local command="$1"
    if [[ -z "${command// }" ]]; then
        echo "error: command cannot be empty" >&2
        return 1
    fi
    if [[ ! "${command}" =~ ^[a-zA-Z0-9\ +./_:@=~-]+$ ]]; then
        echo "error: invalid characters in command" >&2
        return 1
    fi
    if [[ "${command}" =~ \.\./\.\. ]]; then
        echo "error: directory traversal not allowed" >&2
        return 1
    fi
    return 0
}

validate_session_name() {
    local name="$1"
    if [[ "${name}" =~ \.\./  ]] || [[ "${name}" =~ ^/ ]] || [[ "${name}" =~ \.\. ]]; then
        return 1
    fi
    if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        return 1
    fi
    return 0
}

validate_template_name() {
    local name="$1"
    if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "error: invalid template name: ${name}" >&2
        return 1
    fi
    return 0
}

validate_mark_entry() {
    local path="$1"
    [[ -z "${path}" ]] && return 0
    if [[ ! "${path}" =~ ^[a-zA-Z0-9._/~-]+$ ]]; then
        echo "error: invalid characters in path: ${path}" >&2
        return 1
    fi
    return 0
}

# =============================================================================
# MARKS MANAGEMENT
# =============================================================================

parse_marks() {
    local target_slot="${1:-}"
    if [[ ! -f "${MARKS_FILE}" ]]; then
        [[ -n "${target_slot}" ]] && return 1
        return 0
    fi

    local found=false
    while IFS= read -r line; do
        [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
        if [[ "${line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
            local slot="${BASH_REMATCH[1]}"
            local path="${BASH_REMATCH[2]}"
            # Trim leading/trailing whitespace
            path="${path#"${path%%[![:space:]]*}"}"
            path="${path%"${path##*[![:space:]]}"}"
            [[ -z "${path}" ]] && continue
            [[ "${slot}" -lt 1 || "${slot}" -gt 9 ]] && continue

            if [[ -n "${target_slot}" ]]; then
                if [[ "${slot}" == "${target_slot}" ]]; then
                    printf '%s\n' "${path}"
                    return 0
                fi
            else
                printf '%s:%s\n' "${slot}" "${path}"
                found=true
            fi
        fi
    done < "${MARKS_FILE}"

    [[ -n "${target_slot}" ]] && return 1
    [[ "${found}" == true ]] && return 0 || return 1
}

mark_set() {
    local slot="$1"
    local session_ref="$2"
    validate_range "${slot}" 1 9 "Slot must be between 1-9"
    [[ -z "${session_ref// }" ]] && error_exit "Cannot set empty mark" 128
    validate_mark_entry "${session_ref}" || error_exit "Invalid mark value: contains unsafe characters" 128

    local -A marks
    local line
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        local s="${line%%:*}"
        local p="${line#*:}"
        marks[${s}]="${p}"
    done < <(parse_marks 2>/dev/null || true)

    marks[${slot}]="${session_ref}"

    local content
    content="# Marks for tmux-shunpo
# Format: SLOT: PATH or SESSION"
    local i
    for i in {1..9}; do
        if [[ -n "${marks[${i}]:-}" ]]; then
            content="${content}
${i}: ${marks[${i}]}"
        fi
    done

    atomic_write "${MARKS_FILE}" "${content}"
}

mark_add() {
    local session_ref
    if [[ -n "${TMUX:-}" ]]; then
        session_ref=$(tmux display-message -p '#S' 2>/dev/null) || {
            notify "Cannot determine current session" "error"
            return 1
        }
    else
        session_ref="${PWD}"
    fi

    local -A marks_by_value
    local -A marks_by_slot
    local line
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        local s="${line%%:*}"
        local p="${line#*:}"
        marks_by_value[${p}]="${s}"
        marks_by_slot[${s}]="${p}"
    done < <(parse_marks 2>/dev/null || true)

    if [[ -n "${marks_by_value[${session_ref}]:-}" ]]; then
        local existing_slot="${marks_by_value[${session_ref}]}"
        if [[ -t 0 ]]; then
            echo "Already marked in slot ${existing_slot}: ${session_ref}"
            return 1
        else
            notify "Already marked in slot ${existing_slot}"
            return 0
        fi
    fi

    local next_slot=1
    while [[ -n "${marks_by_slot[${next_slot}]:-}" && ${next_slot} -le 9 ]]; do
        next_slot=$((next_slot + 1))
    done

    if [[ ${next_slot} -gt 9 ]]; then
        notify "Error: all mark slots (1-9) are full" "error"
        return 1
    fi

    mark_set "${next_slot}" "${session_ref}"

    if [[ -t 0 ]]; then
        echo "Added mark ${next_slot}: ${session_ref}"
    else
        notify "Added mark ${next_slot}"
    fi
}

mark_remove() {
    local target="$1"
    if [[ -z "${target}" ]]; then
        echo "Error: no target specified for remove" >&2
        return 1
    fi

    if [[ "${target}" == "all" ]]; then
        atomic_write "${MARKS_FILE}" "# Marks for tmux-shunpo"
        notify "Removed all marks"
        return 0
    fi

    if [[ ! "${target}" =~ ^[0-9]+$ ]]; then
        echo "Error: mark slot must be a number or 'all'" >&2
        return 1
    fi

    local path
    if ! path=$(parse_marks "${target}" 2>/dev/null); then
        echo "Error: mark slot ${target} does not exist" >&2
        return 1
    fi

    local -A marks
    local line
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        local s="${line%%:*}"
        local p="${line#*:}"
        marks[${s}]="${p}"
    done < <(parse_marks 2>/dev/null || true)

    unset "marks[${target}]"

    local content="# Marks for tmux-shunpo"
    local i
    for i in {1..9}; do
        if [[ -n "${marks[${i}]:-}" ]]; then
            content="${content}
${i}: ${marks[${i}]}"
        fi
    done

    atomic_write "${MARKS_FILE}" "${content}"
    mark_rearrange
    notify "Removed mark ${target}: ${path}"
}

mark_rearrange() {
    if [[ ! -f "${MARKS_FILE}" ]]; then
        return 0
    fi

    local paths=()
    local line
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        local p="${line#*:}"
        paths+=("${p}")
    done < <(parse_marks 2>/dev/null || true)

    if [[ ${#paths[@]} -eq 0 ]]; then
        return 0
    fi

    local content="# Marks for tmux-shunpo"
    local new_slot=1
    local path
    for path in "${paths[@]}"; do
        content="${content}
${new_slot}: ${path}"
        new_slot=$((new_slot + 1))
    done

    atomic_write "${MARKS_FILE}" "${content}"
}

mark_remove_invalid() {
    local slot="$1"
    local invalid_path="$2"
    local content="# Marks for tmux-shunpo"
    local line
    while IFS= read -r line; do
        [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
        if [[ "${line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
            local s="${BASH_REMATCH[1]}"
            local p="${BASH_REMATCH[2]}"
            p="${p#"${p%%[![:space:]]*}"}"
            p="${p%"${p##*[![:space:]]}"}"
            if [[ "${s}" != "${slot}" || "${p}" != "${invalid_path}" ]]; then
                content="${content}
${s}: ${p}"
            fi
        fi
    done < "${MARKS_FILE}"
    atomic_write "${MARKS_FILE}" "${content}"
    mark_rearrange
}

mark_jump_to() {
    local target="$1"
    local session_ref=""

    if [[ -z "${target}" ]]; then
        error_exit "No target specified for goto"
    fi

    if [[ "${target}" =~ ^[0-9]+$ ]]; then
        if session_ref=$(parse_marks "${target}"); then
            if [[ "${session_ref}" == /* || "${session_ref}" == ~* ]]; then
                # Expand tilde for filesystem check (-d does not expand ~)
                local check_path="${session_ref/#\~/${HOME}}"
                if [[ ! -d "${check_path}" ]]; then
                    # session_ref is a path that no longer exists
                    mark_remove_invalid "${target}" "${session_ref}" 2>/dev/null || true
                    error_exit "Mark ${target} path no longer exists"
                fi
            fi
            local sesh_err
            if ! sesh_err=$(sesh connect "${session_ref}" 2>&1); then
                error_exit "Failed to connect to '${session_ref}': ${sesh_err}"
            fi
            return 0
        fi
    fi

    # Mark not found — notify and exit clean in keybinding context
    notify "Mark ${target} not configured (use --marks to edit marks)"
    if [[ ! -t 0 && -n "${TMUX:-}" ]]; then
        return 0
    fi
    return 1
}

# =============================================================================
# TOOL TEMPLATES (from sesh.toml)
# =============================================================================

config_load_tool_templates() {
    _sesh_load_templates
    local name
    for name in "${!_SESH_TEMPLATES[@]}"; do
        [[ -n "${_SESH_TEMPLATES[${name}]:-}" ]] && echo "${name}:::${_SESH_TEMPLATES[${name}]}"
    done
}

sesh_resolve_window_template() {
    local template_name="$1"
    validate_template_name "${template_name}" || return 1
    _sesh_load_templates
    if [[ -n "${_SESH_TEMPLATES[${template_name}]:-}" ]]; then
        echo "${_SESH_TEMPLATES[${template_name}]}"
        return 0
    fi
    return 1
}

# =============================================================================
# TOOLS MANAGEMENT
# =============================================================================

tool_auto_populate() {
    local session_name="$1"
    validate_session_name "${session_name}" || return 1
    local tools_file="${DATA_DIR}/tools/${session_name}"

    if [[ -f "${tools_file}" ]]; then
        return 0
    fi

    local entries_comma=""  # comma-separated window names
    local source_label=""
    local entry_mode=""  # "direct" (shunpo config) | "sesh" (bare names, prepend @)

    # Priority 1: tmux-shunpo config default_tools (in memory, no forks)
    if [[ -n "${CFG_DEFAULT_TOOLS_JSON:-}" ]]; then
        # Parse JSON array to comma-separated string
        entries_comma=$(printf '%s' "${CFG_DEFAULT_TOOLS_JSON}" | yq -o csv '.[]' 2>/dev/null | tr '\n' ',' | sed 's/,$//') || entries_comma=""
        source_label="tmux-shunpo config default_tools"
        entry_mode="direct"
    else
        # Priority 2-4: sesh session → wildcard → default (cached, 0 yq forks after first load)
        _sesh_load_sessions

        if [[ -n "${_SESH_SESSION_WINDOWS[${session_name}]:-}" ]]; then
            # Priority 2: session name match
            entries_comma="${_SESH_SESSION_WINDOWS[${session_name}]}"
            source_label="sesh.toml session=${session_name}"
            entry_mode="sesh"
        else
            # Priority 3: wildcard match (bash glob, no yq)
            local session_path="${_SESH_SESSION_PATHS[${session_name}]:-}"
            if [[ -z "${session_path}" ]]; then
                session_path=$(tmux display-message -p '#{session_path}' 2>/dev/null) || true
            fi
            session_path="${session_path/#\~/${HOME}}"

            if [[ -n "${session_path}" ]]; then
                local pattern
                for pattern in "${_SESH_WILDCARD_PATTERNS[@]}"; do
                    local expanded_pattern="${pattern/#\~/${HOME}}"
                    # shellcheck disable=SC2254
                    case "${session_path}" in
                        ${expanded_pattern})
                            entries_comma="${_SESH_WILDCARD_WINDOWS[${pattern}]}"
                            source_label="sesh.toml wildcard=${pattern}"
                            entry_mode="sesh"
                            break
                            ;;
                    esac
                done
            fi

            # Priority 4: default session
            if [[ -z "${entries_comma}" && -n "${_SESH_DEFAULT_WINDOWS}" ]]; then
                entries_comma="${_SESH_DEFAULT_WINDOWS}"
                source_label="sesh.toml default_session"
                entry_mode="sesh"
            fi
        fi
    fi

    if [[ -z "${entries_comma}" ]]; then
        return 0
    fi

    mkdir -p "${tools_file%/*}"
    local content="# auto-generated from ${source_label}"
    local slot=1 entry
    local IFS=','
    for entry in ${entries_comma}; do
        [[ -z "${entry}" ]] && continue
        [[ ${slot} -gt 9 ]] && break

        local stored=""
        if [[ "${entry_mode}" == "direct" ]]; then
            if [[ "${entry}" =~ ^@([a-zA-Z0-9_-]+)$ ]]; then
                local tmpl="${BASH_REMATCH[1]}"
                validate_template_name "${tmpl}" 2>/dev/null || continue
                stored="@${tmpl}"
            else
                validate_command "${entry}" 2>/dev/null || continue
                stored="${entry}"
            fi
        else
            # sesh: bare template name → prepend @ for resolution
            validate_template_name "${entry}" 2>/dev/null || continue
            stored="@${entry}"
        fi

        content="${content}
${slot}: ${stored}"
        slot=$((slot + 1))
    done
    unset IFS

    atomic_write "${tools_file}" "${content}"
}

get_tool() {
    local session_name="$1"
    local slot="$2"

    validate_session_name "${session_name}" || error_exit "Invalid session name: ${session_name}"
    validate_range "${slot}" 1 9 "Tool slot must be between 1-9"

    local tools_dir="${DATA_DIR}/tools"
    [[ -d "${tools_dir}" ]] || mkdir -p "${tools_dir}" 2>/dev/null || error_exit "Cannot create tools directory: ${tools_dir}"

    local tools_file="${tools_dir}/${session_name}"

    tool_auto_populate "${session_name}"

    if [[ ! -f "${tools_file}" ]]; then
        return 1
    fi

    local found=false
    local line
    while IFS= read -r line; do
        [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
        if [[ "${line}" =~ ^${slot}:[[:space:]]*(.+)$ ]]; then
            local command="${BASH_REMATCH[1]}"
            command="${command#"${command%%[![:space:]]*}"}"
            command="${command%"${command##*[![:space:]]}"}"
            if [[ -n "${command}" ]]; then
                local resolved_command="${command}"
                # Resolve @template → actual command for window naming + execution
                if [[ "${command}" =~ ^@([a-zA-Z0-9_-]+)$ ]]; then
                    local tmpl="${BASH_REMATCH[1]}"
                    local resolved
                    resolved=$(sesh_resolve_window_template "${tmpl}" 2>/dev/null) || true
                    if [[ -n "${resolved}" ]]; then
                        resolved_command="${resolved}"
                    elif [[ "${tmpl}" == "shell" ]]; then
                        resolved_command="shell"
                    fi
                fi
                local window_name
                window_name=$(generate_window_name "${resolved_command}")
                # Output: name:::raw_command:::resolved_command
                # resolved_command lets caller skip duplicate yq resolution
                echo "${window_name}:::${command}:::${resolved_command}"
                found=true
            fi
            break
        fi
    done < "${tools_file}"

    [[ "${found}" == true ]] && return 0 || return 1
}

tool_set() {
    local session_name="$1"
    local slot="$2"
    local command="$3"

    validate_session_name "${session_name}" || error_exit "Invalid session name: ${session_name}"
    validate_range "${slot}" 1 9 "Slot must be between 1-9"

    local tools_file="${DATA_DIR}/tools/${session_name}"
    mkdir -p "${tools_file%/*}" || error_exit "Cannot create tools directory"

    local -A tools
    local line
    if [[ -f "${tools_file}" ]]; then
        while IFS= read -r line; do
            [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
            if [[ "${line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
                local s="${BASH_REMATCH[1]}"
                local c="${BASH_REMATCH[2]}"
                c="${c#"${c%%[![:space:]]*}"}"
                c="${c%"${c##*[![:space:]]}"}"
                [[ -n "${c}" ]] && tools[${s}]="${c}"
            fi
        done < "${tools_file}"
    fi

    tools[${slot}]="${command}"

    local content="# Tools for session: ${session_name}"
    local i
    for i in {1..9}; do
        if [[ -n "${tools[${i}]:-}" ]]; then
            content="${content}
${i}: ${tools[${i}]}"
        fi
    done

    atomic_write "${tools_file}" "${content}"
}

tool_remove() {
    local session_name="$1"
    local slot="$2"

    validate_session_name "${session_name}" || error_exit "Invalid session name: ${session_name}"
    validate_range "${slot}" 1 9 "Slot must be between 1-9"

    local tools_file="${DATA_DIR}/tools/${session_name}"
    [[ ! -f "${tools_file}" ]] && return 0

    local -A tools
    local line
    while IFS= read -r line; do
        [[ -z "${line}" || "${line}" =~ ^[[:space:]]*# ]] && continue
        if [[ "${line}" =~ ^([0-9]+):[[:space:]]*(.+)$ ]]; then
            local s="${BASH_REMATCH[1]}"
            local c="${BASH_REMATCH[2]}"
            c="${c#"${c%%[![:space:]]*}"}"
            c="${c%"${c##*[![:space:]]}"}"
            [[ -n "${c}" ]] && tools[${s}]="${c}"
        fi
    done < "${tools_file}"

    unset "tools[${slot}]"

    local content="# Tools for session: ${session_name}"
    local i
    for i in {1..9}; do
        if [[ -n "${tools[${i}]:-}" ]]; then
            content="${content}
${i}: ${tools[${i}]}"
        fi
    done

    atomic_write "${tools_file}" "${content}"
}

generate_window_name() {
    local command="$1"
    local custom_name="${2:-}"

    if [[ -n "${custom_name}" ]]; then
        # Pure bash: replace space/:/  with dash, strip unsafe chars
        local sanitized="${custom_name//[ \/:]/-}"
        sanitized="${sanitized//[\(\)\[\]\{\}\|\&\;]/}"
        printf '%s\n' "${sanitized}"
        return 0
    fi

    local first_word="${command%% *}"

    # Pure bash: strip non-alphanumeric/underscore/dash chars (no sed fork)
    local window_name="${first_word//[^a-zA-Z0-9_-]/}"
    if [[ -z "${window_name}" ]]; then
        echo "window"
    else
        printf '%s\n' "${window_name:0:${CFG_WINDOW_NAME_MAX_LENGTH}}"
    fi
}

navigate_to_tool() {
    local slot="$1"
    validate_range "${slot}" 1 9 "Invalid slot '${slot}'. Use 1-9"

    local session_info
    session_info=$(tmux display-message -p '#S #{session_path}' 2>/dev/null) || error_exit "Not in a tmux session"

    local session_name session_path
    read -r session_name session_path <<< "${session_info}"

    local window_index=$((CFG_TOOL_WINDOW_BASE + slot - 1))

    local tool_data
    if ! tool_data=$(get_tool "${session_name}" "${slot}"); then
        local error_msg="No tool set for slot ${slot} in session '${session_name}'"
        if [[ -t 0 ]]; then
            error_exit "${error_msg}. Use --tools to edit tools for this session"
        else
            notify "Tool @${slot} not configured (use --tools to edit tools)"
            return 0
        fi
    fi

    local name="${tool_data%%:::*}"
    local rest="${tool_data#*:::}"
    local raw_command="${rest%%:::*}"
    local command="${rest#*:::}"  # pre-resolved by get_tool (no duplicate yq call)

    # Handle unresolved templates (shell special case or missing template)
    if [[ "${raw_command}" =~ ^@([a-zA-Z0-9_-]+)$ && "${command}" == "${raw_command}" ]]; then
        local tmpl="${BASH_REMATCH[1]}"
        if [[ "${tmpl}" == "shell" ]]; then
            command="$(tmux show-option -gv default-shell)"
        else
            error_exit "Template '@${tmpl}' not found in sesh.toml"
        fi
    fi

    # Security: validate final command before execution
    if [[ ! "${command}" =~ ^@ ]]; then
        if ! validate_command "${command}" 2>/dev/null; then
            error_exit "Security: invalid command for tool @${slot}: ${command}"
        fi
    fi

    local is_shell_only=false
    case "${command}" in
        bash|zsh|sh|fish|ksh|tcsh) is_shell_only=true ;;
    esac

    local window_info
    window_info=$(tmux list-windows -F "#{window_index} #{window_panes}" 2>/dev/null | grep "^${window_index} " || true)

    local window_exists=false
    local has_panes=false

    if [[ -n "${window_info}" ]]; then
        window_exists=true
        local pane_count="${window_info##* }"  # bash string op instead of echo|cut fork
        [[ "${pane_count}" -gt 0 ]] && has_panes=true
    fi

    if [[ "${window_exists}" == true && "${has_panes}" == true ]]; then
        local pane_info
        pane_info=$(tmux display-message -p -t ":${window_index}.0" "#{pane_current_command} #{pane_pid}" 2>/dev/null || true)

        local current_cmd pane_pid
        read -r current_cmd pane_pid <<< "${pane_info}"

        local is_idle=false
        case "${current_cmd}" in
            bash|zsh|sh|fish)
                if [[ -n "${pane_pid}" ]]; then
                    # pgrep -P exits 1 when no children; need set +e for pipefail
                    local child_count
                    set +e
                    child_count=$(pgrep -P "${pane_pid}" 2>/dev/null | wc -l)
                    set -e
                    child_count="${child_count// /}"  # trim whitespace (macOS wc pads)
                    [[ "${child_count}" -eq 0 ]] && is_idle=true
                fi
                ;;
        esac

        if [[ "${is_idle}" == true && "${is_shell_only}" == false ]]; then
            tmux send-keys -t ":${window_index}" -l -- "${command}"
            tmux send-keys -t ":${window_index}" C-m
        fi

        tmux select-window -t ":${window_index}"
    else
        [[ "${window_exists}" == true ]] && tmux kill-window -t ":${window_index}" 2>/dev/null || true

        tmux new-window -t ":${window_index}" -n "${CFG_TOOL_WINDOW_PREFIX}${name}" -c "${session_path}"

        # Poll for shell readiness instead of fixed sleep.
        # Most shells start in <50ms; polling catches them faster than sleeping.
        local _poll_attempt=0
        while [[ ${_poll_attempt} -lt 20 ]]; do
            local _pane_cmd
            _pane_cmd=$(tmux display-message -p -t ":${window_index}.0" '#{pane_current_command}' 2>/dev/null) || break
            case "${_pane_cmd}" in
                bash|zsh|sh|fish) break ;;
            esac
            sleep 0.01
            _poll_attempt=$((_poll_attempt + 1))
        done
        # Brief settle delay for prompt init (Starship etc.)
        sleep "${CFG_SHELL_INIT_DELAY}"

        if [[ "${is_shell_only}" == false ]]; then
            tmux send-keys -t ":${window_index}" -l -- "${command}"
            tmux send-keys -t ":${window_index}" C-m
        fi

        tmux select-window -t ":${window_index}"
    fi
}

# =============================================================================
# SEARCH (sesh + fzf)
# =============================================================================

get_finder() {
    if command_exists fzf; then
        echo "fzf"
    elif command_exists sk; then
        echo "sk"
    else
        return 1
    fi
}

search_and_connect() {
    local selected=""
    local finder
    finder=$(get_finder) || error_exit "fzf or sk not found"

    # Build finder args array (avoids quoting/word-splitting issues)
    local -a finder_args=(
        --ansi
        --no-sort
        --height "${CFG_FINDER_HEIGHT_PERCENT}%"
        --layout reverse
        --border
        --prompt "${CFG_TOOL_WINDOW_PREFIX} "
        --header "  ^a all  ^t tmux  ^g configs  ^z zoxide  ^d kill"
        --preview-window "right:${CFG_FINDER_PREVIEW_PERCENT}%"
        --preview 'sesh preview {}'
    )
    if [[ "${finder}" == "fzf" ]]; then
        finder_args+=(
            --border-label ' shunpo → sesh '
            --bind 'tab:down,btab:up'
            --bind "ctrl-a:change-prompt(${CFG_TOOL_WINDOW_PREFIX}  )+reload(sesh list --icons)"
            --bind 'ctrl-t:change-prompt(  )+reload(sesh list -t --icons)'
            --bind 'ctrl-g:change-prompt(  )+reload(sesh list -c --icons)'
            --bind 'ctrl-z:change-prompt(  )+reload(sesh list -z --icons)'
            --bind "ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(${CFG_TOOL_WINDOW_PREFIX}  )+reload(sesh list --icons)"
        )
    fi

    if [[ ! -t 0 && -n "${TMUX:-}" ]]; then
        local temp_file
        temp_file=$(mktemp -t tmux-shunpo.XXXXXX) || {
            notify "Error: could not create temporary file" "error"
            return 1
        }
        trap 'rm -f "'"${temp_file}"'"' EXIT INT TERM

        # Serialize array into popup command string
        local cmd_args
        cmd_args=$(printf '%q ' "${finder_args[@]}")

        set +e
        tmux popup -E -w "${CFG_POPUP_WIDTH}" -h "${CFG_POPUP_HEIGHT}" \
            "sesh list --icons | ${finder} ${cmd_args} > '${temp_file}'"
        local rc=$?
        set -e

        if [[ ${rc} -eq 0 && -s "${temp_file}" ]]; then
            selected=$(head -n1 "${temp_file}")
        fi
        rm -f "${temp_file}"
    else
        set +e
        selected=$(sesh list --icons | "${finder}" "${finder_args[@]}")
        set -e
    fi

    if [[ -n "${selected}" ]]; then
        if ! sesh connect "${selected}"; then
            notify "Failed to connect to session: ${selected}" "error"
            return 1
        fi
    fi
    # Empty selection = user cancelled (e.g. Escape in fzf) — silent exit
    return 0
}

